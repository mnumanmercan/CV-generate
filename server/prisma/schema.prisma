generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext]
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  ENTERPRISE // schema-ready; no implementation in Phase 2
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE // 3-day grace period before enforcement
  CANCELED
  INCOMPLETE // Stripe incomplete checkout
  TRIALING
}

enum TokenType {
  REFRESH
  PASSWORD_RESET
  EMAIL_VERIFY
}

enum FeedbackVote {
  UP
  DOWN
}

// ─── User ─────────────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.Citext // case-insensitive via citext extension
  name          String
  passwordHash  String
  emailVerified Boolean  @default(false)
  avatarUrl     String? // profile photo (Pro only — Phase 3: R2/S3 URL)
  plan          Plan     @default(FREE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cvs             CV[]
  coverLetters    CoverLetter[]
  tokens          Token[]
  subscription    Subscription?
  waitlistEntry   WaitlistEntry?
  summaryAnalyses SummaryAnalysis[]
  summaryFeedback SummaryFeedback[]

  @@index([email])
}

// ─── Subscription ─────────────────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId               String             @unique @db.Uuid
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  gracePeriodEndsAt    DateTime? // set on first PAST_DUE; 3 days after failure
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([status])
}

// ─── Token ────────────────────────────────────────────────────────────────────
// Stores refresh tokens, password reset tokens, and email verify tokens.
// tokenHash = SHA-256(rawToken) — raw value lives only in the HttpOnly cookie.

model Token {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime? // soft-delete; null = active

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

// ─── CV ───────────────────────────────────────────────────────────────────────
// content stores the full CVData object as JSONB — exact match with frontend interface.

model CV {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  title     String   @default("Untitled CV")
  content   Json // PostgreSQL JSONB — stores CVData verbatim
  shareSlug String?  @unique // null = private; unguessable token when a public share link is active
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  // Composite index for the hottest query — `findMany({ where: { userId }, orderBy: { updatedAt: 'desc' } })`.
  // Postgres can satisfy filter + sort + LIMIT from this index alone instead of
  // scanning every user row and re-sorting in memory once tables grow.
  @@index([userId, updatedAt(sort: Desc)])
}

// ─── CoverLetter ──────────────────────────────────────────────────────────────
// content stores the full CoverLetterData object as JSONB.
// Phase 2: one cover letter per user. Phase 3: multiple (like CVs).

model CoverLetter {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  title     String   @default("Untitled Cover Letter")
  content   Json // PostgreSQL JSONB — stores CoverLetterData verbatim
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([updatedAt])
  @@index([userId, updatedAt(sort: Desc)])
}

// ─── StripeEvent ──────────────────────────────────────────────────────────────
// Idempotency table for Stripe webhooks. Stripe delivers events at-least-once
// (retries on 5xx for up to 3 days, and occasional duplicate deliveries under
// normal conditions). Inserting the event ID before processing — and aborting
// on unique-constraint violation — guarantees each event mutates state once.
//
// Retention: rows are only needed for the duration of Stripe's retry window
// (~3 days). A periodic job can delete rows older than 14 days; for now we
// keep them indefinitely for audit purposes.

model StripeEvent {
  id          String   @id // Stripe event ID, e.g. "evt_1A2B3C..."
  type        String // e.g. "checkout.session.completed"
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Waitlist ─────────────────────────────────────────────────────────────────

model WaitlistEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email     String   @unique @db.Citext
  userId    String?  @unique @db.Uuid // null if not yet registered
  source    String   @default("upgrade_modal")
  notified  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([notified])
}

// ─── SummaryAnalysis ──────────────────────────────────────────────────────────
// One persisted AI summary analysis. Captured on every /ai/analyze-summary call
// so each output is an attributable, versioned data point for the evals loop:
//   - `input`/`output` are JSONB snapshots (CV summary text is PII — same
//     category the CV table already stores; removed via Cascade on user delete).
//   - `model` + `promptVersion` tie the output to exactly what produced it,
//     enabling A/B comparison and regression attribution across prompt revisions.
//   - token/latency columns are lightweight usage + cost telemetry.
// Retention: a periodic job may prune rows with no `feedback` older than ~90d;
// voted rows are eval gold and kept.

model SummaryAnalysis {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @db.Uuid
  input           Json // { summary, locale, jobTitle?, experience?, skills? } snapshot
  output          Json // { feedback, suggestion }
  model           String // e.g. "claude-haiku-4-5"
  promptVersion   String // e.g. "1.0.0"
  plan            Plan
  inputTokens     Int? // response.usage.input_tokens
  outputTokens    Int? // response.usage.output_tokens
  cacheReadTokens Int? // response.usage.cache_read_input_tokens
  latencyMs       Int? // wall-clock of the Anthropic call
  createdAt       DateTime @default(now())

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback SummaryFeedback?

  @@index([userId])
  @@index([promptVersion])
  @@index([createdAt])
}

// ─── SummaryFeedback ──────────────────────────────────────────────────────────
// A user's up/down vote on a SummaryAnalysis (+ reason codes on a downvote).
// `analysisId @unique` enforces one vote per analysis; the controller upserts so
// a user can flip their vote. `reasons` holds codes from the shared taxonomy
// (packages/shared SUMMARY_FEEDBACK_REASONS) — the inverse of the eval rubric
// dimensions, which makes downvote error-analysis map straight onto the judge.

model SummaryFeedback {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  analysisId String       @unique @db.Uuid
  userId     String       @db.Uuid
  vote       FeedbackVote
  reasons    String[] // reason codes on a downvote; empty for an upvote
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  analysis SummaryAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([vote])
}
